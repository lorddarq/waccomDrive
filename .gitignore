.DS_Store
build/
.swiftpm/
.build/

# Local automation and workspace configuration (no published CI for now).
/.github/
/.codex/

# Local diagnostics; retain the documented regression fixtures.
*.log
/captures/*
!/captures/first-session-excerpt.txt
